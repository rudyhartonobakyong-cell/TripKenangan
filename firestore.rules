rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function isTripMember(tripId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/trips/$(tripId)) &&
             request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    function isValidSharedTrip(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isValidInviteCode(data.inviteCode) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 &&
             data.memberUids[0] is string &&
             data.ownerId in data.memberUids &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTripInvite(data) {
      return isValidId(data.tripId) &&
             data.tripTitle is string && data.tripTitle.size() >= 1 && data.tripTitle.size() <= 80 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidTripMember(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.photoUrl is string && data.photoUrl.size() <= 500 &&
             (data.role == 'owner' || data.role == 'member') &&
             data.inviteCodeUsed is string && data.inviteCodeUsed.size() <= 6 &&
             data.joinedAt is timestamp;
    }

    function isValidSharedVisit(data) {
      return isValidId(data.tripId) &&
             data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 160 &&
             data.tripTitle is string && data.tripTitle.size() <= 80 &&
             data.visitDateEpochDay is int && data.visitDateEpochDay >= 0 && data.visitDateEpochDay <= 100000 &&
             data.visitHour is int && data.visitHour >= 0 && data.visitHour <= 23 &&
             data.visitMinute is int && data.visitMinute >= 0 && data.visitMinute <= 59 &&
             data.planNotes is string && data.planNotes.size() <= 500 &&
             data.memoryNotes is string && data.memoryNotes.size() <= 1000 &&
             data.completedManually is bool &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTripComment(data) {
      return isValidId(data.tripId) &&
             data.dateEpochDay is int && data.dateEpochDay >= 0 && data.dateEpochDay <= 100000 &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. Trip Bersama
    match /trips/{tripId} {
      allow get: if isSignedIn() && isValidId(tripId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;

      allow create: if isSignedIn() &&
                       isValidId(tripId) &&
                       incoming().keys().hasAll(['title', 'ownerId', 'inviteCode', 'memberUids', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'ownerId', 'inviteCode', 'memberUids', 'createdAt', 'updatedAt']) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       incoming().createdAt <= request.time &&
                       isValidSharedTrip(incoming()) &&
                       existsAfter(/databases/$(database)/documents/trip_invites/$(incoming().inviteCode)) &&
                       existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(tripId) &&
                       isValidSharedTrip(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().inviteCode == existing().inviteCode &&
                       incoming().createdAt == existing().createdAt && (
                         // Aksi 1: Pemilik mengubah judul trip
                         (
                           request.auth.uid == existing().ownerId &&
                           incoming().memberUids == existing().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])
                         ) ||
                         // Aksi 2: Pengguna baru bergabung memakai kode undangan yang sah
                         (
                           !(request.auth.uid in existing().memberUids) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                           request.auth.uid in incoming().memberUids &&
                           existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
                           getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.inviteCodeUsed == existing().inviteCode
                         )
                       );

      allow delete: if isSignedIn() && isValidId(tripId) && existing().ownerId == request.auth.uid;

      // 2. Anggota Trip
      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(tripId) && isValidId(memberId) && isTripMember(tripId);
        allow list: if isSignedIn() && isValidId(tripId) && isTripMember(tripId);

        allow create: if isSignedIn() &&
                         isValidId(tripId) &&
                         isValidId(memberId) &&
                         memberId == request.auth.uid &&
                         incoming().uid == request.auth.uid &&
                         incoming().keys().hasAll(['uid', 'displayName', 'photoUrl', 'role', 'inviteCodeUsed', 'joinedAt']) &&
                         incoming().keys().hasOnly(['uid', 'displayName', 'photoUrl', 'role', 'inviteCodeUsed', 'joinedAt']) &&
                         incoming().joinedAt <= request.time &&
                         isValidTripMember(incoming()) && (
                           // Pembuat trip mendaftarkan diri sebagai owner saat membuat trip
                           (
                             incoming().role == 'owner' &&
                             incoming().inviteCodeUsed == '' &&
                             existsAfter(/databases/$(database)/documents/trips/$(tripId)) &&
                             getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid
                           ) ||
                           // Anggota bergabung dengan kode undangan yang cocok
                           (
                             incoming().role == 'member' &&
                             isValidInviteCode(incoming().inviteCodeUsed) &&
                             exists(/databases/$(database)/documents/trips/$(tripId)) &&
                             incoming().inviteCodeUsed == get(/databases/$(database)/documents/trips/$(tripId)).data.inviteCode &&
                             request.auth.uid in getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
                           )
                         );

        allow update: if isSignedIn() &&
                         isValidId(tripId) &&
                         isValidId(memberId) &&
                         memberId == request.auth.uid &&
                         isTripMember(tripId) &&
                         isValidTripMember(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().role == existing().role &&
                         incoming().inviteCodeUsed == existing().inviteCodeUsed &&
                         incoming().joinedAt == existing().joinedAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl']);

        allow delete: if false;
      }

      // 3. Lokasi Kunjungan Trip Bersama
      match /visits/{visitId} {
        allow get: if isSignedIn() && isValidId(tripId) && isValidId(visitId) && isTripMember(tripId);
        allow list: if isSignedIn() && isValidId(tripId) && isTripMember(tripId);

        allow create: if isSignedIn() &&
                         isValidId(tripId) &&
                         isValidId(visitId) &&
                         isTripMember(tripId) &&
                         incoming().tripId == tripId &&
                         incoming().createdByUid == request.auth.uid &&
                         incoming().keys().hasAll(['tripId', 'locationName', 'tripTitle', 'visitDateEpochDay', 'visitHour', 'visitMinute', 'planNotes', 'memoryNotes', 'completedManually', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['tripId', 'locationName', 'tripTitle', 'visitDateEpochDay', 'visitHour', 'visitMinute', 'planNotes', 'memoryNotes', 'completedManually', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt <= request.time &&
                         isValidSharedVisit(incoming());

        allow update: if isSignedIn() &&
                         isValidId(tripId) &&
                         isValidId(visitId) &&
                         isTripMember(tripId) &&
                         isValidSharedVisit(incoming()) &&
                         incoming().tripId == existing().tripId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdByName == existing().createdByName &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'locationName', 'tripTitle', 'visitDateEpochDay',
                           'visitHour', 'visitMinute', 'planNotes',
                           'memoryNotes', 'completedManually', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(tripId) && isValidId(visitId) && isTripMember(tripId);
      }

      // 4. Komentar per Tanggal pada Trip Bersama
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(tripId) && isValidId(commentId) && isTripMember(tripId);
        allow list: if isSignedIn() && isValidId(tripId) && isTripMember(tripId);

        allow create: if isSignedIn() &&
                         isValidId(tripId) &&
                         isValidId(commentId) &&
                         isTripMember(tripId) &&
                         incoming().tripId == tripId &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().keys().hasAll(['tripId', 'dateEpochDay', 'authorUid', 'authorName', 'authorPhotoUrl', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['tripId', 'dateEpochDay', 'authorUid', 'authorName', 'authorPhotoUrl', 'text', 'createdAt']) &&
                         isValidTripComment(incoming());

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(tripId) &&
                         isValidId(commentId) &&
                         isTripMember(tripId) &&
                         existing().authorUid == request.auth.uid;
      }
    }

    // 5. Lookup Kode Undangan 6 Karakter
    match /trip_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidInviteCode(inviteCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidInviteCode(inviteCode) &&
                       incoming().keys().hasAll(['tripId', 'tripTitle', 'ownerId', 'createdAt']) &&
                       incoming().keys().hasOnly(['tripId', 'tripTitle', 'ownerId', 'createdAt']) &&
                       incoming().ownerId == request.auth.uid &&
                       isValidTripInvite(incoming()) &&
                       existsAfter(/databases/$(database)/documents/trips/$(incoming().tripId)) &&
                       getAfter(/databases/$(database)/documents/trips/$(incoming().tripId)).data.ownerId == request.auth.uid &&
                       getAfter(/databases/$(database)/documents/trips/$(incoming().tripId)).data.inviteCode == inviteCode;

      allow update: if false;
      allow delete: if isSignedIn() && isValidInviteCode(inviteCode) && existing().ownerId == request.auth.uid;
    }

    // 6. Tes Koneksi Diagnostik per Pengguna
    match /connection_tests/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
